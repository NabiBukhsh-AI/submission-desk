# Submission Desk configuration.
#
# Copy to .env and fill in. Every value here is deliberately empty: this file
# documents the variable names and their defaults, and never carries a real
# value, a key, or a path that exists on someone's machine.
#
# The system runs with all of this unset. Defaults are noted per line and the
# local adapters, the fake model provider, and demo mode need no credentials.

# --- Runtime -----------------------------------------------------------------

APP_ENV=                          # local | pilot | demo. Default: local
DEMO_MODE=                        # true forces the synthetic corpus and disables every sink. Default: false
REVIEWER_ID=                      # identity recorded on each ReviewDecision. Required to approve
PILOT_DATA_DIR=                   # absolute path to real pilot documents, outside this repository
RETENTION_DAYS=                   # age at which purge removes pilot data. Default: 30
STALE_RUN_MINUTES=                # a run untouched for this long is reconciled as INTERRUPTED. Default: 30

# --- Storage -----------------------------------------------------------------

DATABASE_PATH=                    # SQLite file. Default: data/db/submission_desk.sqlite
BLOB_DIR=                         # content-addressed document store. Default: data/blobs

# --- Model access ------------------------------------------------------------

MODEL_PROVIDER=                   # fake | live. Default: fake, which replays fixtures and needs no key
MODEL_API_KEY=                    # provider credential. Never commit a value
MODEL_API_BASE_URL=               # override the provider endpoint. Leave empty for the default
MODEL_ROUTING_POLICY=             # all_cheap | all_strong | routed. Default: routed

# --- Budget and limits -------------------------------------------------------

TOKEN_CEILING_PER_RUN=            # hard per-run ceiling; the run halts when breached. Default: 120000
MAX_ESCALATIONS_PER_CANDIDATE=    # cap on stronger-tier re-assessments. Default: 3
MAX_DOCUMENTS_PER_CANDIDATE=      # documents accepted per candidate before rejecting the batch. Default: 8
STRUCTURE_MAX_INPUT_TOKENS=       # input ceiling for the profile extraction call. Default: 24000
ASSESS_MAX_INPUT_TOKENS=          # input ceiling for one criterion assessment call. Default: 12000
ASSESS_CHUNK_K=                   # document chunks supplied per criterion. Default: 6
ASSESS_CONCURRENCY=               # criteria assessed in parallel. Default: 4
BATCH_CONCURRENCY=                # candidates processed in parallel in a batch run. Default: 2

# --- Documents and language --------------------------------------------------

ALLOWED_LANGUAGES=                # comma list processed normally. Default: en
SUPPORTED_LANGUAGES=              # comma list processed with a degraded-quality flag. Default: en,ko
OCR_TRIGGER_CPP=                  # characters per page below which OCR takes over for that page. Default: 100
OCR_MAX_PAGES=                    # OCR page ceiling before routing to manual review. Default: 20
OCR_MIN_CONFIDENCE=               # below this, the page carries a quality flag. Default: 0.6
TESSERACT_BINARY=                 # path to the reader, if it is not on PATH. Usually unnecessary

# --- Assessment behaviour ----------------------------------------------------

BLIND_MODE=                       # true redacts identity before any model call. Default: per rubric
SUSPECT_CONFIDENCE=               # detector confidence at or above which a HIGH finding quarantines. Default: 0.75
CALIBRATION_ENABLED=              # true retrieves past decided candidates as anchors. Default: false
CALIBRATION_MAX_AGE_DAYS=         # anchors older than this are not retrieved. Default: 180

# --- Integrations ------------------------------------------------------------

SOURCE_ADAPTER=                   # local | drive. Default: local
SINK_ADAPTERS=                    # comma list. csv is always first and cannot be removed. Default: csv
NOTIFIER_ADAPTER=                 # console | slack. Default: console

GOOGLE_APPLICATION_CREDENTIALS=   # path to the service account JSON. Never commit the file
DRIVE_FOLDER_ID=                  # the single Drive folder shared with the service account, read-only
DRIVE_QPS=                        # token bucket rate for Drive calls. Default: 4
DRIVE_MOCK=                       # true wires the fixture-serving fake into the demo. Default: false
SHEETS_SPREADSHEET_ID=            # the one spreadsheet the sink may append to
SLACK_BOT_TOKEN=                  # bot token, chat:write only. Never commit a value
SLACK_CHANNEL=                    # channel id for the three batch-level events

# --- Logging -----------------------------------------------------------------

LOG_SPANS=                        # true logs evidence spans, truncated to 120 characters. Default: false
