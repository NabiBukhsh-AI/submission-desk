# Submission Desk configuration.
#
# Copy to .env and fill in. Every value here is deliberately empty: this file
# documents the variable names and their defaults, and never carries a real
# value, a key, or a path that exists on someone's machine.
#
# The system runs with all of this unset. Defaults are the offline ones: the
# fake model provider, the local folder source, the CSV sink, the console
# notifier. Every variable listed here is read by the code; limits that are
# not environment variables live in config/limits.yaml.

# --- Runtime -----------------------------------------------------------------

DEMO_MODE=                        # true reads only data/samples/synthetic, removes every sink and notifier, and refuses any real document path. Default: false
REVIEWER_ID=                      # identity recorded on each decision. Required to approve anything
PILOT_DATA_DIR=                   # absolute path to real pilot documents, outside this repository. Refused in demo mode
RETENTION_DAYS=                   # age at which `submission-desk purge` removes finished runs. Default: 30
STALE_RUN_MINUTES=                # a run untouched for this long is reconciled as interrupted at startup. Default: 15

# --- The admin account and the browser ---------------------------------------

APP_SECRET=                       # seals stored API keys and signs the session cookie. Default: generated once into <db dir>/app_secret. Set it explicitly for any deployment that is not one laptop
CORS_ORIGINS=                     # comma-separated browser origins allowed to call the API with the session cookie. Default: http://localhost:5173 (the Vite dev server)

# --- Storage -----------------------------------------------------------------

DATABASE_PATH=                    # SQLite file. Default: data/db/submission_desk.sqlite
BLOB_DIR=                         # content-addressed document store. Default: data/blobs
INBOX_DIR=                        # folder the local source reads candidates from. Default: data/inbox. Must be under data/samples/ in demo mode

# --- Model access ------------------------------------------------------------

# Everything in this block can also be set on the admin page (Settings), which
# wins over the environment and keeps the key sealed in the database.
MODEL_PROVIDER=                   # fake | anthropic | openrouter. Default: fake, which replays fixtures and falls back to the deterministic stand-in
MODEL_API_KEY=                    # the chosen provider's key. Never commit a value
MODEL_API_BASE_URL=               # provider endpoint. Leave empty for the provider's own
MODEL_CHEAP_ID=                   # provider identifier bound to tier_cheap when config/models.yaml leaves it empty
MODEL_STRONG_ID=                  # provider identifier bound to tier_strong when config/models.yaml leaves it empty
MODEL_ROUTING_POLICY=             # all_cheap | all_strong | routed. Default: routed

# --- Budget and limits -------------------------------------------------------

TOKEN_CEILING_PER_RUN=            # hard per-run ceiling; the run halts before the call that would cross it. Default: 120000
MAX_ESCALATIONS_PER_CANDIDATE=    # cap on stronger-tier re-assessments per run. Default: 3
STRUCTURE_MAX_INPUT_TOKENS=       # input ceiling for the profile extraction call. Default: 24000
ASSESS_MAX_INPUT_TOKENS=          # input ceiling for one criterion assessment call. Default: 12000
ASSESS_CHUNK_K=                   # document chunks supplied per criterion. Default: 6
ASSESS_CONCURRENCY=               # criteria assessed in parallel. Default: 4

# --- Documents ---------------------------------------------------------------

TESSERACT_BINARY=                 # path to the OCR binary, if it is not on PATH. Usually unnecessary
EXTRACTION_CONFIDENCE_WARN=       # below this, an extracted page is flagged to the reviewer. Default: 0.6

# --- Security ----------------------------------------------------------------

SANITIZE_RENDER_DIFF=             # compare rendered pixels with extracted text for hidden content. Default: true
RENDER_DIFF_MAX_PAGES=            # skip the render comparison above this many pages. Default: 10
SUSPECT_CONFIDENCE=               # detector confidence at or above which a HIGH finding quarantines. Default: 0.75
SANITIZE_CLASSIFY=                # ask the cheap tier for a second opinion on borderline findings; it may only raise severity. Default: false

# --- Assessment behaviour ----------------------------------------------------

BLIND_MODE=                       # true removes identity tokens before any model call. Default: true
CALIBRATION_ENABLED=              # true retrieves past approved decisions as anchors. Default: false
CALIBRATION_TOP_K=                # how many anchors are offered. Default: 3
CALIBRATION_STALENESS_DAYS=       # anchors older than this are not retrieved. Default: 180

# --- Integrations ------------------------------------------------------------

SOURCE_ADAPTER=                   # local | drive. Default: local. Must be local in demo mode
GOOGLE_APPLICATION_CREDENTIALS=   # path to the service account JSON. Never commit the file
DRIVE_FOLDER_ID=                  # the single Drive folder shared with the service account, read-only
SHEETS_SPREADSHEET_ID=            # the one spreadsheet the sink may append to
SLACK_BOT_TOKEN=                  # bot token, chat:write only. Never commit a value
SLACK_CHANNEL=                    # channel id for batch-level notifications

# --- Logging -----------------------------------------------------------------

LOG_SPANS=                        # true logs evidence spans, truncated to 120 characters. Default: false
LOG_CONSOLE=                      # true prints one line per node and model call to the terminal. `make api` sets it
LOG_DIR=                          # where the JSONL event log goes. Default: data/logs
