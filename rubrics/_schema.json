{
  "$defs": {
    "Band": {
      "description": "The recommendation. Computed by ``aggregate``, never emitted by a model.",
      "enum": [
        "advance",
        "advance_with_reservations",
        "hold",
        "decline",
        "insufficient_information",
        "manual_review_required"
      ],
      "title": "Band",
      "type": "string"
    },
    "BandThreshold": {
      "additionalProperties": false,
      "properties": {
        "band": {
          "$ref": "#/$defs/Band"
        },
        "min_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Score",
          "type": "number"
        }
      },
      "required": [
        "band",
        "min_score"
      ],
      "title": "BandThreshold",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CriterionKind"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "min_supported": {
          "default": 1,
          "minimum": 0,
          "title": "Min Supported",
          "type": "integer"
        },
        "negative_examples": {
          "items": {
            "type": "string"
          },
          "title": "Negative Examples",
          "type": "array"
        },
        "positive_examples": {
          "items": {
            "type": "string"
          },
          "title": "Positive Examples",
          "type": "array"
        },
        "question": {
          "maxLength": 1000,
          "minLength": 10,
          "title": "Question",
          "type": "string"
        },
        "state_points": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "$ref": "#/$defs/CriterionState"
          },
          "title": "State Points",
          "type": "object"
        },
        "weight": {
          "maximum": 10,
          "minimum": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "question",
        "kind",
        "weight",
        "state_points"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "CriterionKind": {
      "enum": [
        "standard",
        "high_stakes",
        "blocker"
      ],
      "title": "CriterionKind",
      "type": "string"
    },
    "CriterionState": {
      "description": "What the rule engine concluded for a criterion, from its evidence.",
      "enum": [
        "met",
        "partial",
        "not_met",
        "contradicted",
        "insufficient_evidence"
      ],
      "title": "CriterionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bands": {
      "items": {
        "$ref": "#/$defs/BandThreshold"
      },
      "minItems": 1,
      "title": "Bands",
      "type": "array"
    },
    "blind_mode_default": {
      "default": true,
      "title": "Blind Mode Default",
      "type": "boolean"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "forbidden_attributes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Forbidden Attributes",
      "type": "array"
    },
    "min_coverage": {
      "default": 0.7,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Min Coverage",
      "type": "number"
    },
    "notes_for_reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes For Reviewer"
    },
    "role_id": {
      "title": "Role Id",
      "type": "string"
    },
    "role_title": {
      "maxLength": 200,
      "minLength": 3,
      "title": "Role Title",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "role_id",
    "role_title",
    "version",
    "criteria",
    "bands"
  ],
  "title": "RoleRubric",
  "type": "object"
}
