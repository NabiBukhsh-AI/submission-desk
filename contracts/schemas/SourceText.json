{
  "$defs": {
    "ExtractionMethod": {
      "enum": [
        "digital_pdf",
        "ocr",
        "docx",
        "plaintext"
      ],
      "title": "ExtractionMethod",
      "type": "string"
    },
    "OffsetRun": {
      "additionalProperties": false,
      "description": "One contiguous stretch where normalised and raw text stay in step.",
      "properties": {
        "length": {
          "exclusiveMinimum": 0,
          "title": "Length",
          "type": "integer"
        },
        "norm_start": {
          "minimum": 0,
          "title": "Norm Start",
          "type": "integer"
        },
        "raw_start": {
          "minimum": 0,
          "title": "Raw Start",
          "type": "integer"
        }
      },
      "required": [
        "norm_start",
        "raw_start",
        "length"
      ],
      "title": "OffsetRun",
      "type": "object"
    },
    "PageSpan": {
      "additionalProperties": false,
      "description": "Where one page begins and ends in normalised coordinates.",
      "properties": {
        "extraction_method": {
          "$ref": "#/$defs/ExtractionMethod"
        },
        "norm_end": {
          "minimum": 0,
          "title": "Norm End",
          "type": "integer"
        },
        "norm_start": {
          "minimum": 0,
          "title": "Norm Start",
          "type": "integer"
        },
        "ocr_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Confidence"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        }
      },
      "required": [
        "page_number",
        "norm_start",
        "norm_end",
        "extraction_method"
      ],
      "title": "PageSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The text of one document, in both coordinate systems.",
  "properties": {
    "block_boundaries": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "title": "Block Boundaries",
      "type": "array"
    },
    "detected_languages": {
      "items": {
        "type": "string"
      },
      "title": "Detected Languages",
      "type": "array"
    },
    "document_id": {
      "format": "uuid",
      "title": "Document Id",
      "type": "string"
    },
    "extraction_confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Extraction Confidence",
      "type": "number"
    },
    "normalization_profile_id": {
      "minLength": 1,
      "title": "Normalization Profile Id",
      "type": "string"
    },
    "normalized_text": {
      "title": "Normalized Text",
      "type": "string"
    },
    "offset_runs": {
      "items": {
        "$ref": "#/$defs/OffsetRun"
      },
      "title": "Offset Runs",
      "type": "array"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageSpan"
      },
      "title": "Pages",
      "type": "array"
    },
    "raw_text": {
      "title": "Raw Text",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "raw_text",
    "normalized_text",
    "offset_runs",
    "pages",
    "normalization_profile_id",
    "extraction_confidence"
  ],
  "title": "SourceText",
  "type": "object"
}
