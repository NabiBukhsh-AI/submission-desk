{
  "$defs": {
    "DeliveryStatus": {
      "enum": [
        "delivered",
        "pending_retry",
        "failed"
      ],
      "title": "DeliveryStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "delivered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivered At"
    },
    "delivery_id": {
      "format": "uuid",
      "title": "Delivery Id",
      "type": "string"
    },
    "external_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Ref"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "sink_id": {
      "minLength": 1,
      "title": "Sink Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DeliveryStatus"
    }
  },
  "required": [
    "delivery_id",
    "run_id",
    "sink_id",
    "status",
    "attempts"
  ],
  "title": "DeliveryRecord",
  "type": "object"
}
